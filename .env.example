AUTH_SECRET=replace-with-at-least-32-random-characters
INITIAL_ADMIN_EMAIL=administrator@example.edu
DATA_DIR=.data
SQLITE_PATH=.data/ucc-microcredentials.sqlite
PORT=3000

# AI course authoring. Supply a provider key or the documented Vertex settings.
OPENAI_API_KEY=
OPENAI_COURSE_MODEL=gpt-5-mini
COURSE_AI_PROVIDER=auto
COURSE_AI_TIMEOUT_SECONDS=120
# Default limit. The administrator can override it in the AI Course Designer.
COURSE_AI_DAILY_LIMIT=30
# Optional estimates per million tokens, using the institution's chosen rates.
# Leave blank to show usage without a cost estimate.
COURSE_AI_INPUT_USD_PER_MILLION=
COURSE_AI_OUTPUT_USD_PER_MILLION=

# LTI 1.3 external learning tools. Tool registration is managed in Course Studio.
# Normally uses NEXT_PUBLIC_APP_URL. Only set this to the same stable public deployment.
LTI_PLATFORM_ISSUER=
# Optional original PKCS8 RSA private key, base64 encoded. Keep stable across deployments.
# If blank, a persistent key is encrypted in SQLite with AUTH_SECRET.
LTI_PLATFORM_PRIVATE_KEY_BASE64=
