+-  const printCertificate = async () => {
+-    const target = expandedFrameRef.current ?? previewFrameRef.current;
+-    if (!target || printing) return;
+-    setPrinting(true);
+-    const oldTitle = document.title;
+-    let restoreImages = () => {};
